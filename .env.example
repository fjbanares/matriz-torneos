# ---------- Desarrollo local (valores por defecto de docker-compose.yml) ----------
DATABASE_URL=postgres://cobrador:cobrador_dev@localhost:5432/cobrador
PGSSL=false

# Secreto para firmar las sesiones. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Superadministrador inicial. Solo se usa la PRIMERA vez (base de datos vacía).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contraseña

PORT=3000
NODE_ENV=development


# ---------- Producción (Neon + Render): NO usar estos valores en local ----------
# DATABASE_URL=postgres://USUARIO:CONTRASEÑA@HOST.neon.tech/NOMBRE   (sin ?sslmode=... al final)
# PGSSL=true
# NODE_ENV=production

# ---------- Producción en una máquina (docker-compose.prod.yml) ----------
# DOMAIN=cobrador.duckdns.org
# POSTGRES_PASSWORD=una-contraseña-larga-solo-para-la-base-de-datos
