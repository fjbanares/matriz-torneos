# Cadena de conexión de PostgreSQL (Neon, Supabase o local)
DATABASE_URL=postgres://usuario:contraseña@host/basedatos

# "true" si la base de datos exige SSL (Neon, Supabase). "false" para Postgres local.
PGSSL=false

# Secreto para firmar las sesiones. Genera uno largo y aleatorio (ver README).
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Superadministrador inicial. Solo se usa la PRIMERA vez que arranca la app
# con una base de datos vacía. Después puedes eliminar ADMIN_PASSWORD.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=una-contraseña-larga

PORT=3000
NODE_ENV=development
